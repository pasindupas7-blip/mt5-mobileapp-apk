{
  "entities": {
    "UserAccountDoc": {
      "title": "UserAccountDoc",
      "description": "Authenticated user's trading account profile and balance document stored at /users/{userId}.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Authenticated user email address."
        },
        "displayName": {
          "type": "string",
          "description": "Authenticated Google user's display name (default Trader)."
        },
        "photoURL": {
          "type": "string",
          "description": "Authenticated Google user's HTTPS profile photo URL (empty string if unavailable)."
        },
        "balance": {
          "type": "number",
          "description": "Current realized trading account balance in account currency (default 10000)."
        },
        "leverage": {
          "type": "integer",
          "description": "Account leverage ratio (default 500)."
        },
        "currency": {
          "type": "string",
          "description": "Account currency code (default USD)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last account update (FieldValue.serverTimestamp())."
        },
        "deposit": {
          "type": "number",
          "description": "Optional cumulative deposit amount."
        },
        "realizedProfit": {
          "type": "number",
          "description": "Optional cumulative realized profit."
        },
        "totalWithdrawal": {
          "type": "number",
          "description": "Optional cumulative withdrawals."
        },
        "totalSwap": {
          "type": "number",
          "description": "Optional cumulative swap."
        },
        "totalCommission": {
          "type": "number",
          "description": "Optional cumulative commission."
        },
        "accountName": {
          "type": "string",
          "description": "Optional display name for the MT5 account."
        },
        "brokerName": {
          "type": "string",
          "description": "Optional broker display name."
        },
        "accountId": {
          "type": "string",
          "description": "Optional MT5 account number/label."
        },
        "serverName": {
          "type": "string",
          "description": "Optional trading server name."
        },
        "isReal": {
          "type": "boolean",
          "description": "Optional flag indicating REAL vs DEMO badge."
        },
        "depositDate": {
          "type": "string",
          "description": "Optional formatted deposit date string."
        },
        "logoType": {
          "type": "string",
          "description": "Optional broker logo preference."
        }
      },
      "required": [
        "email",
        "balance",
        "leverage",
        "currency",
        "createdAt"
      ]
    },
    "OpenTradeDoc": {
      "title": "OpenTradeDoc",
      "description": "An active open trading position stored under /users/{userId}/open_trades/{tradeId}. Floating P&L and live prices are never stored in Firestore.",
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Trading symbol (e.g., XAUUSD, EURUSD, NAS100)."
        },
        "type": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ],
          "description": "Order direction."
        },
        "lots": {
          "type": "number",
          "description": "Trade volume in lots."
        },
        "openPrice": {
          "type": "number",
          "description": "Entry execution price."
        },
        "sl": {
          "type": "number",
          "description": "Stop Loss price (0 when unset)."
        },
        "tp": {
          "type": "number",
          "description": "Take Profit price (0 when unset)."
        },
        "commission": {
          "type": "number",
          "description": "Commission amount as numeric value."
        },
        "swap": {
          "type": "number",
          "description": "Swap amount as numeric value."
        },
        "openTime": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when position was opened (FieldValue.serverTimestamp())."
        },
        "ticketId": {
          "type": "integer",
          "description": "Optional MT5 numeric ticket identifier."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional server timestamp of last SL/TP modification."
        }
      },
      "required": [
        "symbol",
        "type",
        "lots",
        "openPrice",
        "sl",
        "tp",
        "commission",
        "swap",
        "openTime"
      ]
    },
    "TradeHistoryDoc": {
      "title": "TradeHistoryDoc",
      "description": "A closed historical trade deal stored under /users/{userId}/trade_history/{dealId}.",
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Trading symbol (e.g., XAUUSD, EURUSD, NAS100) or Balance for withdrawals."
        },
        "type": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL",
            "WITHDRAWAL",
            "BALANCE"
          ],
          "description": "Closed trade direction or balance operation."
        },
        "lots": {
          "type": "number",
          "description": "Closed volume in lots."
        },
        "openPrice": {
          "type": "number",
          "description": "Entry execution price."
        },
        "closePrice": {
          "type": "number",
          "description": "Exit execution price."
        },
        "profit": {
          "type": "number",
          "description": "Gross realized profit in USD."
        },
        "commission": {
          "type": "number",
          "description": "Commission fee in USD."
        },
        "swap": {
          "type": "number",
          "description": "Swap adjustment in USD."
        },
        "netProfit": {
          "type": "number",
          "description": "Net realized profit (grossProfit - commission + swap)."
        },
        "openTime": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the trade was opened."
        },
        "closeTime": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the trade was closed (FieldValue.serverTimestamp())."
        },
        "ticketId": {
          "type": "integer",
          "description": "Optional MT5 numeric ticket identifier."
        },
        "sl": {
          "type": "number",
          "description": "Optional Stop Loss price."
        },
        "tp": {
          "type": "number",
          "description": "Optional Take Profit price."
        },
        "isWithdrawal": {
          "type": "boolean",
          "description": "Optional flag for withdrawal ledger records."
        },
        "comment": {
          "type": "string",
          "description": "Optional trade or withdrawal comment."
        },
        "hitOutcome": {
          "type": "string",
          "enum": [
            "NONE",
            "TP_HIT",
            "SL_HIT"
          ],
          "description": "Optional TP/SL hit outcome."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional server timestamp of last update."
        }
      },
      "required": [
        "symbol",
        "type",
        "lots",
        "openPrice",
        "closePrice",
        "profit",
        "commission",
        "swap",
        "netProfit",
        "openTime",
        "closeTime"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccountDoc"
      },
      "description": "Stores each authenticated user's unified account balance, leverage, currency, and optional display settings."
    },
    "/users/{userId}/open_trades/{tradeId}": {
      "schema": {
        "$ref": "#/entities/OpenTradeDoc"
      },
      "description": "Stores active open trades for cross-platform Android and iOS real-time sync."
    },
    "/users/{userId}/trade_history/{dealId}": {
      "schema": {
        "$ref": "#/entities/TradeHistoryDoc"
      },
      "description": "Stores closed historical deals atomically recorded during Trade Close transactions."
    }
  }
}
