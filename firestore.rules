rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNum(val) {
      return val is int || val is float;
    }

    function isValidUserAccount(data) {
      return data.email is string && data.email.size() <= 254 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024 && (data.photoURL == '' || data.photoURL.matches('^https://.*')))) &&
             isNum(data.balance) &&
             isNum(data.leverage) && data.leverage >= 1 && data.leverage <= 5000 &&
             data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 12 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             (!('deposit' in data) || (isNum(data.deposit) && data.deposit >= 0)) &&
             (!('realizedProfit' in data) || isNum(data.realizedProfit)) &&
             (!('totalWithdrawal' in data) || (isNum(data.totalWithdrawal) && data.totalWithdrawal >= 0)) &&
             (!('totalSwap' in data) || isNum(data.totalSwap)) &&
             (!('totalCommission' in data) || isNum(data.totalCommission)) &&
             (!('accountName' in data) || (data.accountName is string && data.accountName.size() <= 128)) &&
             (!('brokerName' in data) || (data.brokerName is string && data.brokerName.size() <= 128)) &&
             (!('accountId' in data) || (data.accountId is string && data.accountId.size() <= 128)) &&
             (!('serverName' in data) || (data.serverName is string && data.serverName.size() <= 128)) &&
             (!('isReal' in data) || data.isReal is bool) &&
             (!('depositDate' in data) || (data.depositDate is string && data.depositDate.size() <= 64)) &&
             (!('logoType' in data) || (data.logoType is string && data.logoType.size() <= 32));
    }

    function isValidOpenTrade(data) {
      return data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32 &&
             data.type is string && (data.type == 'BUY' || data.type == 'SELL') &&
             isNum(data.lots) && data.lots > 0 && data.lots <= 1000 &&
             isNum(data.openPrice) && data.openPrice > 0 &&
             isNum(data.sl) && data.sl >= 0 &&
             isNum(data.tp) && data.tp >= 0 &&
             isNum(data.commission) &&
             isNum(data.swap) &&
             data.openTime is timestamp && data.openTime <= request.time &&
             (!('ticketId' in data) || (isNum(data.ticketId) && data.ticketId > 0)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidTradeHistory(data) {
      return data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32 &&
             data.type is string && (data.type == 'BUY' || data.type == 'SELL' || data.type == 'WITHDRAWAL' || data.type == 'BALANCE') &&
             isNum(data.lots) && data.lots > 0 && data.lots <= 1000 &&
             isNum(data.openPrice) && data.openPrice > 0 &&
             isNum(data.closePrice) && data.closePrice > 0 &&
             isNum(data.profit) &&
             isNum(data.commission) &&
             isNum(data.swap) &&
             isNum(data.netProfit) &&
             data.openTime is timestamp && data.openTime <= request.time &&
             data.closeTime is timestamp && data.closeTime <= request.time &&
             (!('ticketId' in data) || (isNum(data.ticketId) && data.ticketId > 0)) &&
             (!('sl' in data) || (isNum(data.sl) && data.sl >= 0)) &&
             (!('tp' in data) || (isNum(data.tp) && data.tp >= 0)) &&
             (!('isWithdrawal' in data) || data.isWithdrawal is bool) &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 200)) &&
             (!('hitOutcome' in data) || (data.hitOutcome is string && (data.hitOutcome == 'NONE' || data.hitOutcome == 'TP_HIT' || data.hitOutcome == 'SL_HIT'))) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId);

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'email', 'balance', 'leverage', 'currency', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'email', 'displayName', 'photoURL', 'balance', 'leverage', 'currency', 'createdAt', 'updatedAt',
                         'deposit', 'realizedProfit', 'totalWithdrawal', 'totalSwap',
                         'totalCommission', 'accountName', 'brokerName', 'accountId',
                         'serverName', 'isReal', 'depositDate', 'logoType'
                       ]) &&
                       isValidUserAccount(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email', 'displayName', 'photoURL', 'balance', 'leverage', 'currency', 'updatedAt',
                         'deposit', 'realizedProfit', 'totalWithdrawal', 'totalSwap',
                         'totalCommission', 'accountName', 'brokerName', 'accountId',
                         'serverName', 'isReal', 'depositDate', 'logoType'
                       ]);

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId);

      match /open_trades/{tradeId} {
        allow get: if isSignedIn() &&
                      request.auth.uid == userId &&
                      isValidId(userId) &&
                      isValidId(tradeId);

        allow list: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId);

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(tradeId) &&
                         incoming().keys().hasAll([
                           'symbol', 'type', 'lots', 'openPrice', 'sl', 'tp',
                           'commission', 'swap', 'openTime'
                         ]) &&
                         incoming().keys().hasOnly([
                           'symbol', 'type', 'lots', 'openPrice', 'sl', 'tp',
                           'commission', 'swap', 'openTime', 'ticketId', 'updatedAt'
                         ]) &&
                         isValidOpenTrade(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(tradeId) &&
                         isValidOpenTrade(incoming()) &&
                         incoming().openTime == existing().openTime &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'sl', 'tp', 'lots', 'openPrice', 'symbol', 'type',
                           'commission', 'swap', 'ticketId', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(tradeId);
      }

      match /trade_history/{dealId} {
        allow get: if isSignedIn() &&
                      request.auth.uid == userId &&
                      isValidId(userId) &&
                      isValidId(dealId);

        allow list: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId);

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(dealId) &&
                         incoming().keys().hasAll([
                           'symbol', 'type', 'lots', 'openPrice', 'closePrice',
                           'profit', 'commission', 'swap', 'netProfit', 'openTime', 'closeTime'
                         ]) &&
                         incoming().keys().hasOnly([
                           'symbol', 'type', 'lots', 'openPrice', 'closePrice',
                           'profit', 'commission', 'swap', 'netProfit', 'openTime', 'closeTime',
                           'ticketId', 'sl', 'tp', 'isWithdrawal', 'comment', 'hitOutcome', 'updatedAt'
                         ]) &&
                         isValidTradeHistory(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(dealId) &&
                         isValidTradeHistory(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'symbol', 'type', 'lots', 'openPrice', 'closePrice',
                           'profit', 'commission', 'swap', 'netProfit', 'openTime', 'closeTime',
                           'ticketId', 'sl', 'tp', 'isWithdrawal', 'comment', 'hitOutcome', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(userId) &&
                         isValidId(dealId);
      }
    }
  }
}
