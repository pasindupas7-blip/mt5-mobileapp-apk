rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNum(val) {
      return val is int || val is float;
    }

    function isValidTicket(val) {
      return (val is int && val > 0) ||
             (val is float && val > 0) ||
             (val is string && val.size() >= 1 && val.size() <= 64);
    }

    function isValidPosition(data, userId) {
      return (!('userId' in data) || (data.userId is string && data.userId == userId)) &&
             (!('ticketId' in data) || data.ticketId == null || isValidTicket(data.ticketId)) &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32 &&
             (!('isBuy' in data) || data.isBuy is bool) &&
             (!('buy' in data) || data.buy is bool) &&
             isNum(data.lots) && data.lots > 0 && data.lots <= 1000 &&
             isNum(data.openPrice) && data.openPrice > 0 &&
             (!('currentPrice' in data) || data.currentPrice == null || (isNum(data.currentPrice) && data.currentPrice > 0)) &&
             isNum(data.profit) &&
             data.openTime is string && data.openTime.size() >= 1 && data.openTime.size() <= 160 &&
             (!('sl' in data) || data.sl == null || (isNum(data.sl) && data.sl >= 0)) &&
             (!('tp' in data) || data.tp == null || (isNum(data.tp) && data.tp >= 0)) &&
             (!('swap' in data) || data.swap == null || isNum(data.swap)) &&
             (!('commission' in data) || data.commission == null || isNum(data.commission)) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is string || isNum(data.createdAt)) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp || data.updatedAt is string || isNum(data.updatedAt));
    }

    function isValidHistoryTrade(data, userId) {
      return (!('userId' in data) || (data.userId is string && data.userId == userId)) &&
             (!('ticketId' in data) || data.ticketId == null || isValidTicket(data.ticketId)) &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32 &&
             (!('isBuy' in data) || data.isBuy is bool) &&
             (!('buy' in data) || data.buy is bool) &&
             isNum(data.lots) && data.lots > 0 && data.lots <= 1000 &&
             isNum(data.openPrice) && data.openPrice > 0 &&
             isNum(data.closePrice) && data.closePrice > 0 &&
             isNum(data.profit) &&
             data.openTime is string && data.openTime.size() >= 1 && data.openTime.size() <= 160 &&
             data.closeTime is string && data.closeTime.size() >= 1 && data.closeTime.size() <= 64 &&
             (!('commission' in data) || data.commission == null || isNum(data.commission)) &&
             (!('swap' in data) || data.swap == null || isNum(data.swap)) &&
             (!('sl' in data) || data.sl == null || (isNum(data.sl) && data.sl >= 0)) &&
             (!('tp' in data) || data.tp == null || (isNum(data.tp) && data.tp >= 0)) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is string || isNum(data.createdAt)) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp || data.updatedAt is string || isNum(data.updatedAt));
    }

    function isValidAccount(data, userId) {
      return (!('userId' in data) || (data.userId is string && data.userId == userId)) &&
             isNum(data.balance) &&
             isNum(data.deposit) &&
             isNum(data.realizedProfit) &&
             (!('totalSwap' in data) || data.totalSwap == null || isNum(data.totalSwap)) &&
             (!('totalCommission' in data) || data.totalCommission == null || isNum(data.totalCommission)) &&
             data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 64 &&
             data.brokerName is string && data.brokerName.size() >= 1 && data.brokerName.size() <= 128 &&
             data.accountId is string && data.accountId.size() >= 1 && data.accountId.size() <= 128 &&
             data.serverName is string && data.serverName.size() >= 1 && data.serverName.size() <= 128 &&
             (!('isReal' in data) || data.isReal is bool) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is string || isNum(data.createdAt)) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp || data.updatedAt is string || isNum(data.updatedAt));
    }

    match /users/{userId}/positions/{positionId} {
      allow get: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId) &&
                    isValidId(positionId);

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     isValidId(userId);

      allow create, update: if isSignedIn() &&
                               request.auth.uid == userId &&
                               isValidId(userId) &&
                               isValidId(positionId) &&
                               incoming().keys().hasAll([
                                 'symbol', 'lots', 'openPrice', 'profit', 'openTime'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'id', 'userId', 'ticketId', 'ticket', 'symbol', 'isBuy', 'buy',
                                 'side', 'type', 'lots', 'openPrice', 'currentPrice', 'sl', 'tp',
                                 'profit', 'swap', 'commission', 'openTime', 'accountKey', 'key',
                                 'createdAt', 'updatedAt'
                               ]) &&
                               isValidPosition(incoming(), userId);

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(positionId);
    }

    match /users/{userId}/history/{historyId} {
      allow get: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId) &&
                    isValidId(historyId);

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     isValidId(userId);

      allow create, update: if isSignedIn() &&
                               request.auth.uid == userId &&
                               isValidId(userId) &&
                               isValidId(historyId) &&
                               incoming().keys().hasAll([
                                 'symbol', 'lots', 'openPrice', 'closePrice', 'profit', 'openTime', 'closeTime'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'id', 'userId', 'ticketId', 'ticket', 'symbol', 'isBuy', 'buy',
                                 'side', 'type', 'lots', 'openPrice', 'closePrice', 'profit',
                                 'openTime', 'closeTime', 'commission', 'swap', 'sl', 'tp',
                                 'isWithdrawal', 'comment', 'hitOutcome', 'accountKey', 'key',
                                 'createdAt', 'updatedAt'
                               ]) &&
                               isValidHistoryTrade(incoming(), userId);

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(historyId);
    }

    match /users/{userId}/accounts/{accountDocId} {
      allow get: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId) &&
                    isValidId(accountDocId);

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     isValidId(userId);

      allow create, update: if isSignedIn() &&
                               request.auth.uid == userId &&
                               isValidId(userId) &&
                               isValidId(accountDocId) &&
                               incoming().keys().hasAll([
                                 'balance', 'deposit', 'realizedProfit',
                                 'accountName', 'brokerName', 'accountId', 'serverName'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'id', 'key', 'userId', 'balance', 'deposit', 'realizedProfit',
                                 'totalSwap', 'totalCommission', 'swap', 'commission',
                                 'accountName', 'brokerName', 'accountId', 'serverName',
                                 'isReal', 'real', 'depositDate', 'logoType',
                                 'createdAt', 'updatedAt'
                               ]) &&
                               isValidAccount(incoming(), userId);

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(accountDocId);
    }
  }
}

